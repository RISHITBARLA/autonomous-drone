# AUTONOMOUS-DRONE Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Server Configuration
DRONE_HOST=0.0.0.0
DRONE_PORT=5000
DRONE_DEBUG=false
SECRET_KEY=autonomous-drone-insecure-dev-key-change-in-production

# Hardware & System Monitoring
ENABLE_MOCK_HARDWARE=false
SYSTEM_POLL_INTERVAL_SECONDS=1.0
TEMP_WARNING_THRESHOLD=75.0
TEMP_CRITICAL_THRESHOLD=85.0
RAM_WARNING_THRESHOLD=85.0
DISK_WARNING_THRESHOLD=90.0

# Camera Configuration
# Backend options: auto (detects hardware), libcamera, opencv, mock
CAMERA_BACKEND=auto
CAMERA_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_PREVIEW_WIDTH=640
CAMERA_PREVIEW_HEIGHT=480
CAMERA_FRAMERATE=30
CAPTURES_DIR=captures

# Computer Vision & QR Detection
QR_DETECTION_ENABLED=true
QR_COOLDOWN_SECONDS=2.0
QR_HISTORY_LIMIT=50
QR_PROCESS_FPS=10.0

# MAVLink Flight Controller Telemetry & Flight Control
# Transport: udp, tcp, or serial (Use 'serial' for Raspberry Pi TELEM2 GPIO UART)
MAVLINK_TRANSPORT=udp

# MAVLink Connection String:
# Connection Options:
# 1. Raspberry Pi TELEM2 GPIO UART (Physical Drone Deployment):
#    Physical Interconnect:
#      Pixhawk TELEM2 Pin 2 (TX) <-> Raspberry Pi Pin 10 (GPIO 15 / RXD / /dev/ttyAMA0)
#      Pixhawk TELEM2 Pin 3 (RX) <-> Raspberry Pi Pin 8  (GPIO 14 / TXD / /dev/ttyAMA0)
#      Pixhawk TELEM2 Pin 6 (GND)<-> Raspberry Pi Pin 6  (GND)
#    Device Node: /dev/serial0 (symlink to /dev/ttyAMA0)
#    Baud Rate: 115200
#    For physical Raspberry Pi deployment, configure:
#      MAVLINK_TRANSPORT=serial
#      MAVLINK_CONNECTION=/dev/serial0
#      MAVLINK_CONNECTION_STRING=/dev/serial0
#      MAVLINK_BAUDRATE=115200
#      MAVLINK_SIMULATE=false
#      FLIGHT_CONTROL_ENABLED=false
#      ARMING_CHECKS_ENABLED=true
#      FORCE_ARM=false
# 2. UDP Network Connection (Local Testing / ESP Bridge):
#    udpin:0.0.0.0:14550 -> Listen on UDP port 14550 for incoming packets from Pixhawk/ESP Wi-Fi bridge.
#    udpout:<pixhawk-ip>:14550 -> Outgoing UDP connection to Pixhawk Wi-Fi bridge.
MAVLINK_CONNECTION=udpin:0.0.0.0:14550
MAVLINK_CONNECTION_STRING=udpin:0.0.0.0:14550
MAVLINK_BAUDRATE=57600
MAVLINK_HEARTBEAT_TIMEOUT=5.0

# Simulation vs Physical Hardware:
# Set to 'false' for physical Pixhawk 2.4.8 hardware over Wi-Fi / Serial.
# Set to 'true' for local virtual simulation (Windows development / testing).
# NOTE: Hardware mode never silently falls back to simulation if disconnected.
MAVLINK_SIMULATE=true

# Flight Control Subsystem (Disabled by default for safety)
# WARNING: Keep false during bench tests without propellers. Set to true only for authorized operator control.
FLIGHT_CONTROL_ENABLED=true

# Target Default Flight Mode (ArduCopter: ALT_HOLD, STABILIZE, LOITER, GUIDED, RTL, LAND)
FLIGHT_MODE=ALT_HOLD

# Safety Constraints (MANDATORY: NEVER MODIFY)
# Firmware pre-arm checks must always remain active on Pixhawk.
ARMING_CHECKS_ENABLED=true
# Force-arming is strictly prohibited to prevent motor spin when safety criteria fail.
FORCE_ARM=false

# Data Persistence Directory
DATA_DIR=data

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=logs/drone_system.log
